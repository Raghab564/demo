# Copy to .env for local (non-docker-compose) runs. docker-compose.yml
# already sets all of these for the containerized stack.

RAILS_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

KAFKA_BROKERS=localhost:9092
KAFKA_TELEMETRY_TOPIC=telemetry.readings

OIDC_ISSUER=https://mock-idp.vitalconnect.local/
OIDC_AUDIENCE=vital-connect-api
OIDC_SHARED_SECRET=local-dev-shared-secret
